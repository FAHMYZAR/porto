{
  "scripts": {
    "dev": "concurrently \"npx tailwindcss -i ./src/input.css -o ./dist/output.css --watch\" \"npx live-server --port=3000 --open=/index.html --watch=index.html,dist,blogs,src\"",
    "build": "npx tailwindcss -i ./src/input.css -o ./dist/output.css --minify && node -e \"require('fs').cpSync('src/js', 'dist/js', {recursive: true})\"",
    "build:prod": "node build-zip.js",
    "deploy": "node build-zip.js",
    "start": "npx live-server --port=3000 --open=/index.html",
    "preview": "npx live-server --port=3000 --open=/index.html --no-browser"
  },
  "devDependencies": {
    "archiver": "^7.0.1",
    "autoprefixer": "^10.4.22",
    "concurrently": "^8.2.2",
    "live-server": "^1.2.2",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17"
  }
}